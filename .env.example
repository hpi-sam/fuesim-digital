# Ports (only change them, if you know what you do)
# The port for the websocket listener
DFM_WEBSOCKET_PORT=3200
# The port of the HTTP Server
DFM_HTTP_PORT=3201
# The public URL where the HTTP server can be reached, e.g. used for generating links and redirects
# e.g. http://localhost:3201
DFM_HTTP_BACKEND_URL=http://localhost:3201
# For local testing with docker
# DFM_HTTP_BACKEND_URL=http://localhost

# The public URL where the Angular frontend can be reached, e.g. used for generating links, redirects and CORS
# e.g. http://localhost:4200
DFM_HTTP_FRONTEND_URL=http://localhost:4200
# For local testing with docker
# DFM_HTTP_FRONTEND_URL=http://localhost

# set the upload limit for nginx and for the backend
DFM_UPLOAD_LIMIT=200m

# enable extra debugging output
#DFM_DEBUG=false

# Days after which unused, anonymous exercises get deleted
DFM_AUTO_DELETE_DAYS=30

# Postgres

DFM_USE_DB=true
DFM_DB_USER=fuesim-digital
# Choose something secure here
#DFM_DB_PASSWORD=
DFM_DB_NAME=fuesim-digital
DFM_DB_HOST=db
DFM_DB_PORT=5432
# Whether or not to log database queries to stdout
DFM_DB_LOG=false


# OIDC

DFM_AUTH_URL=http://127.0.0.1:9091
# For local testing with docker
# DFM_AUTH_URL=http://authelia.localhost:9091
DFM_AUTH_CLIENT_ID=fuesim-digital
DFM_AUTH_CLIENT_SECRET=ZMuRxjZ0AbSvKAtvWH85kOf1db2OmLoXzFw4UsZC~TcewXaiMExdGPVXv9qP4eNj3GG55Tky
# this is an example for keycloak
# DFM_AUTH_SELF_SERVICE_URL=http://127.0.0.1:8080/realms/master/account/#/personal-info
# can be 'keycloak' or left empty for no registration
# DFM_AUTH_USER_REGISTRATION_ADAPTER=keycloak

# Message of the day banner

# undefined for no banner,  [primary | secondary | success | danger | warning | info | light | dark] for alert color (https://getbootstrap.com/docs/4.0/components/alerts/)
DFM_BANNER_TYPE=primary
# Raw html rendered inside the alert
DFM_BANNER_MESSAGE="<h2>Sie nutzen eine experimentelle Version!</h2><p>Probieren Sie gerne unsere neuen Funktionen aus. Falls Sie die alte Version der FüSim nutzen wollen, <a href="https://fuesim.digital">klicken Sie hier</a>.</p>"

# DEVELOPER SETTINGS - only used when running in dev mode

DFM_DEV_NO_WAITING_ROOM=false # Setting this variable will break the exercise cypress tests!

# Feature Flags

DFM_PARALLEL_EXERCISES_ENABLED=true
