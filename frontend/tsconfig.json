/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
    "compilerOptions": {
        "target": "ES2022",
        // Strictness
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "forceConsistentCasingInFileNames": true,
        "noPropertyAccessFromIndexSignature": true,
        "noImplicitOverride": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        // Compatibility
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true, // Needed for eslint consistent-type-imports https://github.com/typescript-eslint/typescript-eslint/issues/2559#issuecomment-692882427
        "isolatedModules": true, // For ts-jest
        "module": "preserve",
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "outDir": "./dist/out-tsc",
        "lib": ["ES2022", "dom"],
        "useDefineForClassFields": false // TODO: Enabling this requires multiple changes in the code
    },
    "compileOnSave": false,
    // this fixes jest globals in .spec.ts being overwritten by cypress globals
    "include": ["src"],
    "angularCompilerOptions": {
        "enableI18nLegacyMessageIdFormat": false,
        "strictInjectionParameters": true,
        "strictInputAccessModifiers": true,
        "strictTemplates": true
    }
}
