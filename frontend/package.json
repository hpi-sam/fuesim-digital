{
    "name": "fuesim-digital-frontend",
    "version": "1.0.0-rc.1",
    "type": "module",
    "scripts": {
        "cy:open": "cypress open",
        "cy:install": "cypress install",
        "cy:run": "cypress run",
        "cy:run:firefox": "cypress run --browser firefox",
        "cy:run:electron": "cypress run --browser electron",
        "cy:run:chromium": "cypress run --browser chromium",
        "cy:update-snapshots": "cypress-image-diff -u",
        "ng": "ng",
        "start": "ng serve --host 127.0.0.1",
        "build": "ng build",
        "build:deployment": "ng build --configuration deployment",
        "watch": "ng build --watch --configuration development",
        "lint": "eslint --max-warnings 0 \"./**/*.{ts,js,yml,css,sccs,html,angular}\"",
        "lint:fix": "eslint --fix \"./**/*.{ts,js,yml,css,sccs,html,angular}\"",
        "test:ci": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --coverage --verbose --ci",
        "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --coverage --verbose",
        "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --verbose --watch"
    },
    "private": true,
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "~26.5.0",
            "onFail": "error"
        },
        "packageManager": {
            "name": "npm",
            "version": "~11.17.0",
            "onFail": "error"
        }
    },
    "dependencies": {
        "@angular/animations": "~22.1.0",
        "@angular/aria": "^21.2.9",
        "@angular/common": "~22.1.0",
        "@angular/compiler": "~22.1.0",
        "@angular/core": "~22.1.0",
        "@angular/forms": "~22.1.0",
        "@angular/material": "^21.2.9",
        "@angular/platform-browser": "~22.1.0",
        "@angular/platform-browser-dynamic": "~22.1.0",
        "@angular/router": "~22.1.0",
        "@ng-bootstrap/ng-bootstrap": "^21.0.0",
        "@ngneat/hotkeys": "^4.1.0",
        "@ngrx/store": "^21.1.1",
        "@popperjs/core": "^2.11.8",
        "bootstrap": "^5.3.3",
        "bootstrap-icons": "^1.11.3",
        "chart.js": "^4.4.8",
        "fuesim-digital-shared": "file:../shared",
        "immer": "^10.1.1",
        "lodash-es": "^4.17.23",
        "maplibre-gl": "^5.17.0",
        "ng-qrcode": "^22.0.0",
        "ngx-editor": "^19.0.0-beta.1",
        "ol": "^10.6.1",
        "papaparse": "^5.5.3",
        "rxjs": "~7.8.0",
        "socket.io-client": "^4.8.1",
        "tslib": "^2.8.1",
        "zod": "^4.1.13",
        "zone.js": "^0.15.1"
    },
    "devDependencies": {
        "@angular/build": "^22.1.1",
        "@angular/cli": "~22.1.1",
        "@angular/compiler-cli": "~22.1.0",
        "@angular/localize": "~22.1.0",
        "@eslint/compat": "^2.1.0",
        "@eslint/js": "~10.0.1",
        "@types/chart.js": "^2.9.41",
        "@types/jest": "^30.0.0",
        "@types/lodash-es": "^4.17.12",
        "@types/node": "^22.14.0",
        "angular-eslint": "^22.1.0",
        "cypress": "^15.17.0",
        "eslint": "~10.8.0",
        "eslint-config-prettier": "^10.1.1",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "~4.17.1",
        "eslint-plugin-unicorn": "^72.0.0",
        "eslint-plugin-rxjs-angular-x": "~1.0.1",
        "eslint-plugin-rxjs-x": "^1.0.4",
        "jest": "^30.2.0",
        "ts-jest": "^29.4.5",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.65.0"
    },
    "overrides": {
        "@istanbuljs/load-nyc-config": {
            "js-yaml": "^4.1.1"
        },
        "@ngrx/store": {
            "@angular/common": "$@angular/common",
            "@angular/core": "$@angular/core"
        }
    },
    "allowScripts": {
        "cypress@15.19.0": true,
        "esbuild@0.28.1": true,
        "lmdb@3.5.6": true,
        "msgpackr-extract@3.0.4": true,
        "@parcel/watcher@2.6.0": true,
        "unrs-resolver@1.12.2": true
    }
}
