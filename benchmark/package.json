{
    "name": "fuesim-digital-benchmark",
    "version": "1.0.0-rc.2",
    "type": "module",
    "scripts": {
        "lint": "eslint --max-warnings 0 \"./**/*.{ts,js,yml,html}\"",
        "lint:fix": "eslint --fix \"./**/*.{ts,js,yml,html}\"",
        "benchmark:linux-macos": "NODE_ENV=production tsx src/app.ts",
        "benchmark:windows": "set NODE_ENV=production&& tsx src/app.ts",
        "benchmark": "(pwd && npm run benchmark:linux-macos) || npm run benchmark:windows"
    },
    "private": true,
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "~26.5.0",
            "onFail": "error"
        },
        "packageManager": {
            "name": "npm",
            "version": "~11.17.0",
            "onFail": "error"
        }
    },
    "dependencies": {
        "fuesim-digital-shared": "file:../shared",
        "immer": "^10.1.1",
        "lodash-es": "^4.17.23"
    },
    "devDependencies": {
        "@eslint/compat": "^2.1.0",
        "@eslint/js": "~10.0.1",
        "@types/lodash-es": "^4.17.12",
        "@types/node": "^22.14.0",
        "eslint": "~10.8.0",
        "eslint-config-prettier": "^10.1.1",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "~4.17.1",
        "eslint-plugin-unicorn": "^72.0.0",
        "tsx": "^4.19.3",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.65.0"
    },
    "overrides": {
        "@istanbuljs/load-nyc-config": {
            "js-yaml": "^4.1.1"
        }
    },
    "allowScripts": {
        "esbuild@0.28.1": true,
        "unrs-resolver@1.12.2": true
    }
}
